{
  "name": "vtop-mobile",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "build:apk": "npm run build && npx cap sync android && cd android && .\\gradlew.bat assembleDebug",
    "bundle:ota": "npm run build && powershell -Command \"New-Item -ItemType Directory -Force ota | Out-Null; Compress-Archive -Path dist/* -DestinationPath ota/bundle.zip -Force\""
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.2",
    "@capacitor/preferences": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "@capgo/capacitor-updater": "^6.51.23",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.18.1",
    "cheerio": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "firebase": "^12.16.0",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "postcss": "^8.5.19",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
